package require tcltest 2
namespace import ::tcltest::test
package require treqmon 2.0.0

set events {{100 10 a} {100 30 b} {120 50 a} {180 70 {}}}
test stats-1 {Summary averages use the requested window} -body {
    ::treqmon::get_summary $events 180
} -result {last_minute_avg_response_time 60 last_half_hour_avg_response_time 40 last_hour_avg_response_time 40 last_day_avg_response_time 40}

test stats-2 {Page views aggregate events per second} -body {
    lsort -integer -stride 2 -index 0 [dict get [::treqmon::get_page_views $events 180] second page_views]
} -result {120 {120 1} 180 {180 1}}

test stats-3 {Response times average each minute} -body {
    lsort -integer -stride 2 -index 0 [dict get [::treqmon::get_response_times $events 180] minute response_times]
} -result {60 {60 20} 120 {120 50} 180 {180 70}}

test stats-4 {Active users count distinct sessions and exclude anonymous events} -body {
    lsort -integer -stride 2 -index 0 [dict get [::treqmon::get_active_users $events 180] minute active_users]
} -result {60 {60 2} 120 {120 1}}

test stats-5 {Empty history preserves empty collections} -body {
    list [dict get [::treqmon::get_page_views {} 180] second page_views] \
        [dict get [::treqmon::get_response_times {} 180] minute top_k_times]
} -result {{} {}}

test stats-6 {Filter supports relative windows and session presence} -body {
    ::treqmon::filter_events $events true 180 -80 -1
} -result {{100 10 a} {100 30 b} {120 50 a}}
::tcltest::cleanupTests
