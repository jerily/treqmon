package require tcltest
namespace import ::tcltest::test
package provide valkey 1.0.1
source [file join [file dirname [info script]] .. tcl valkeystore.tcl]

proc valkey {args} {set ::connection_args $args; return test_client}

test valkeystore-tls-1 {TLS and ACL options survive main and worker initialization} -body {
    set input {host localhost port 6379 ssl true username appuser password {test password} ssl_ca_file ca.pem ssl_cert_file client.pem ssl_key_file client.key timeout 1500 history_max_events 12}
    set output {}
    ::treqmon::valkeystore::init_main output $input
    ::treqmon::middleware::valkeystore::init [dict get $output store valkeystore]
    set ::connection_args
} -result {-host localhost -port 6379 -ssl -username appuser -password {test password} -ssl_ca_file ca.pem -ssl_cert_file client.pem -ssl_key_file client.key -timeout 1500}

rename valkey {}
unset ::connection_args
::tcltest::cleanupTests
