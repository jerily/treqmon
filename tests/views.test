package require tcltest 2
namespace import ::tcltest::test
package require treqmon 2.1.0
::treqmon::view::init

test views-1 {Empty data renders six charts with zero summary} -body {
    set html [::treqmon::render_stats {}]
    list [regexp -all {<canvas } $html] [string match {*Last minute: 0*} $html] \
        [string match {*&quot;type&quot;:&quot;line&quot;*} $html]
} -result {6 1 1}

test views-2 {Session charts are explicit} -body {
    regexp -all {<canvas } [::treqmon::render_stats {} true]
} -result 9

test views-3 {Real events render summary and maxima} -body {
    set now [clock seconds]
    set html [::treqmon::render_stats [list [list $now 12 user] [list $now 24 user]] true]
    list [string match {*Last minute: 18*} $html] [string match {*Active Users*} $html] \
        [string match {*: 2</small>*} $html]
} -result {1 1 1}

test views-4 {Chart attributes escape HTML and never evaluate Tcl} -body {
    set ::executed 0
    set attack {[set ::executed 1]<script>"&}
    set fields [list M [list chart [list M [list title [list S $attack] \
        config [list S $attack] top {L {}}]]]]
    set html [::jinja2::render [dict get $::treqmon::view::templates chart.html.jinja] \
        [::tjson::typed_to_json $fields]]
    list $::executed [string match {*&lt;script&gt;&quot;&amp;*} $html] \
        [string match {*<script>*} $html]
} -result {0 1 0}

test views-5 {Charts fill missing buckets with zero for every interval} -body {
    set result {}
    foreach {interval step} {second 1 minute 60 hour 3600} {
        set stats [dict create $interval [dict create xrange [list 0 [expr {2 * $step}]] \
            page_views [dict create $step [list $step 7]] top_k_views [list [list $step 7]]]]
        set chart [::treqmon::view::chart $stats $interval page_views {Page Views} Views top_k_views]
        set chart [::tjson::json_to_simple [::tjson::typed_to_json $chart]]
        set config [::tjson::json_to_simple [dict get $chart config]]
        lappend result [dict get [lindex [dict get $config data datasets] 0] data]
    }
    set result
} -result {{0 7 0} {0 7 0} {0 7 0}}

::tcltest::cleanupTests
